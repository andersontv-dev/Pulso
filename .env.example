# ---------------------------------------------------------------------------
# Pulso — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore: las credenciales NUNCA se commitean.
# ---------------------------------------------------------------------------

# --- form30x API (obligatorio) ---------------------------------------------
# Origen de la API, SIN el sufijo `/api/v1`.
#
# La documentación declara `https://form.30x.com/api/v1` como base, pero el
# dominio real de form30x es `form.oracle30x.co` (confirmado por el equipo);
# es también desde donde se sirven el portal de desarrolladores y el MCP.
FORM30X_API_URL=https://form.oracle30x.co

# Bearer token generado en /developers. Se muestra una sola vez.
#
# ⚠️  AVISO DE SEGURIDAD (textual de la documentación de form30x):
#     «una key válida lee y edita CUALQUIER formulario de la compañía. Los
#     scopes separan lectura de escritura, no un formulario de otro.»
#     Genera la key SOLO con los scopes `forms:read` y `responses:read`.
#     Pulso nunca escribe. Esta variable es server-only y jamás llega al
#     navegador: si aparece en el bundle del cliente, es un bug.
FORM30X_API_KEY=f30x_live_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Comportamiento ---------------------------------------------------------
# Huso horario de negocio para agrupar el desglose diario. `submittedAt` llega
# en UTC; sin esto los días quedan corridos varias horas.
PULSO_TIMEZONE=America/Bogota

# Refresco automático del dashboard, en ms. Solo se aplica cuando el rango de
# fechas incluye hoy y la pestaña está visible.
PULSO_POLL_INTERVAL_MS=60000

# TTL del caché en servidor, en ms. Varias personas mirando el dashboard
# comparten una sola tanda de llamadas a form30x.
PULSO_CACHE_TTL_MS=45000

# Peticiones concurrentes máximas contra form30x. La documentación no publica
# rate limit, así que el valor por defecto es deliberadamente conservador.
PULSO_MAX_CONCURRENCY=4

# --- Paginación -------------------------------------------------------------
# Tope de páginas por formulario. La API pagina de 200 en 200, así que 50
# páginas son 10.000 respuestas. Si se alcanza, Pulso lo avisa en pantalla en
# vez de devolver datos incompletos como si fueran completos.
FORM30X_MAX_PAGES=50

# Cuánto se cachea la estructura de un formulario (qué campos tiene). Cambia
# mucho menos que sus respuestas, así que aguanta más.
PULSO_ESTRUCTURA_TTL_MS=600000

# --- Desarrollo y tests -----------------------------------------------------
# Con `1`, Pulso sirve fixtures deterministas en vez de llamar a la API. Es lo
# que usan los tests e2e y permite arrancar el proyecto sin credenciales.
PULSO_USE_FIXTURES=0
